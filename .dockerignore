# Only the code goes into the image: no data, no runs, no secrets, no local environments.
.git
.github
.devcontainer
.claude
.vscode
.idea
.venv*
**/__pycache__
**/*.py[cod]
.pytest_cache
.ruff_cache

# The web site is built inside the image (its own stage)
web/node_modules
web/dist

# Data and outputs live in the server volume, never in the image
data
artifacts
artifacts.*
runs
customers
var

# Secrets
.env
.streamlit/secrets.toml

# Tests and course material
backend/tests
frontend/tests
*.pdf
