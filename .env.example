# Copy to .env and fill in. Never commit .env.

# The dataset spec the pipeline runs on, as pkg.module:ATTR (or pass --spec on the command line).
# The real spec: pulse_specs.workforce_saas.spec:SPEC (the toy test spec is tests.toy_spec:SPEC).
PIPELINE_DATASET_SPEC=pulse_specs.workforce_saas.spec:SPEC

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# "llm" or "deterministic". Empty means llm when GEMINI_API_KEY is set, otherwise deterministic.
PIPELINE_MODE=

# Runtime flags. The packages also set these at import time; PYTHONHASHSEED and PYTHONUTF8
# only take effect when set in the parent shell before Python starts.
PYTHONHASHSEED=0
PYTHONUTF8=1
OMP_NUM_THREADS=2
CREWAI_DISABLE_TELEMETRY=true
OTEL_SDK_DISABLED=true
CREWAI_TRACING_ENABLED=false

# Optional: where the dashboard and the API read artifacts from (default: ./artifacts)
ARTIFACTS_DIR=
# Optional: where the dashboard and the copilot read run folders from (default: ./runs)
RUNS_DIR=

# docker compose only: the customer folder the dashboard and the API show (default: demo)
# PULSE_CUSTOMER=demo
# Optional: the port of pulse-api outside compose (when set it listens on 0.0.0.0, else 127.0.0.1:8000)
# PORT=8000
# Optional: the repository root, when the code runs from an installed wheel
# PULSE_REPO_ROOT=

# The dashboard's ops copilot. A passcode locks the chat until it is entered; empty: open.
COPILOT_PASSCODE=
# Optional: messages per session (default 25)
# COPILOT_MAX_MESSAGES=25
# Optional: the copilot's Gemini model (default in backend/pulse_copilot/agent.py)
# COPILOT_MODEL=
