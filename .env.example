# Copy to .env and fill in. Never commit .env.

# The dataset spec the pipeline runs on, as pkg.module:ATTR (or pass --spec on the command line).
# The real spec: pulse_specs.workforce_saas.spec:SPEC (the toy test spec is tests.toy_spec:SPEC).
PIPELINE_DATASET_SPEC=pulse_specs.workforce_saas.spec:SPEC

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# "llm" or "deterministic". Empty means llm when GEMINI_API_KEY is set, otherwise deterministic.
PIPELINE_MODE=

# Runtime flags. The packages also set these at import time; PYTHONHASHSEED and PYTHONUTF8
# only take effect when set in the parent shell before Python starts.
PYTHONHASHSEED=0
PYTHONUTF8=1
OMP_NUM_THREADS=2
CREWAI_DISABLE_TELEMETRY=true
OTEL_SDK_DISABLED=true
CREWAI_TRACING_ENABLED=false

# Optional: where the dashboard and the API read artifacts from (default: ./artifacts)
ARTIFACTS_DIR=
# Optional: where the dashboard and the copilot read run folders from (default: ./runs)
RUNS_DIR=

# docker compose only: the customer folder the dashboard and the API show (default: demo)
# PULSE_CUSTOMER=demo
# Optional: the port of pulse-api outside compose (when set it listens on 0.0.0.0, else 127.0.0.1:8000)
# PORT=8000
# Optional: the repository root, when the code runs from an installed wheel
# PULSE_REPO_ROOT=

# The dashboard's ops copilot. A passcode locks the chat until it is entered; empty: open.
COPILOT_PASSCODE=
# Optional: messages per session (default 25)
# COPILOT_MAX_MESSAGES=25
# Optional: the copilot's Gemini model (default in backend/pulse_copilot/agent.py)
# COPILOT_MODEL=

# ---------------------------------------------------------------- the site's server (pulse-server)
# production (default) or development. Production refuses the dev login and needs PULSE_SECRET_KEY.
PULSE_ENV=production
# Signs the sign-in state. At least 32 characters:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
PULSE_SECRET_KEY=
# The address users reach the site at, exactly as in the browser (writes from another origin are
# refused). The OAuth redirect URIs are {PULSE_PUBLIC_URL}/auth/google/callback and
# {PULSE_PUBLIC_URL}/auth/microsoft/callback. https makes the cookies Secure. With `npm run dev`
# in web/: http://localhost:5173.
PULSE_PUBLIC_URL=http://localhost:8100
# Operators: comma-separated addresses; they sign in with a verified address and approve companies.
PULSE_OPERATOR_EMAILS=
# Google and Microsoft sign-in: each provider is on when both its id and secret are set.
PULSE_GOOGLE_CLIENT_ID=
PULSE_GOOGLE_CLIENT_SECRET=
PULSE_MICROSOFT_CLIENT_ID=
PULSE_MICROSOFT_CLIENT_SECRET=
# organizations (work and school accounts, default), or one tenant's id
# PULSE_MICROSOFT_TENANT=organizations
# Development only: sign in with any address, no password (refused when PULSE_ENV=production)
# PULSE_DEV_LOGIN=1
# Outside compose: the database (default sqlite:///./var/pulse-server.db) and the customer
# folders (default ./customers). compose sets both (Postgres, /srv/pulse/customers).
# PULSE_DATABASE_URL=
# PULSE_CUSTOMERS_ROOT=
# PULSE_SESSION_DAYS=14
# The built web site (default web/dist; the image has it there too)
# PULSE_WEB_DIR=
# The worker's folder: job logs and the demo export (default ./var; compose: /srv/pulse/work)
# PULSE_WORK_DIR=
# The largest upload, in MB (default 1024)
# PULSE_MAX_UPLOAD_MB=1024
# How long reading or applying an export, and a pipeline run, may take (minutes)
# PULSE_STEP_TIMEOUT_MINUTES=20
# PULSE_RUN_TIMEOUT_MINUTES=40
# compose's Postgres password: set it before the first `up` (the database keeps the first one).
# Default: pulse; the port is never published.
# POSTGRES_PASSWORD=
